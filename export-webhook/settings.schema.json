{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "request-log-webhook settings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "url"
  ],
  "properties": {
    "url": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/reference"
        }
      ],
      "description": "The HTTPS webhook target, as a literal URL or an env/file/module reference resolved by the host."
    },
    "auth_header": {
      "type": "object",
      "description": "An optional auth header applied to every delivery from this instance.",
      "additionalProperties": false,
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "The header's name, e.g. Authorization."
        },
        "value": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/reference"
            }
          ],
          "description": "The complete credential header value, preferably provided by an env/file/module reference such as {\"env\":\"WEBHOOK_AUTHORIZATION\"}. The export host also preserves existing literal values."
        }
      }
    },
    "max_inflight_deliveries": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2305843009213693951,
      "default": 64,
      "description": "Max concurrent deliveries."
    },
    "delivery_timeout_secs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 946080000,
      "default": 2,
      "description": "Per-delivery timeout, seconds."
    }
  },
  "$defs": {
    "reference": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "env"
          ],
          "properties": {
            "env": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file"
          ],
          "properties": {
            "file": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "module"
          ],
          "properties": {
            "module": {
              "type": "string"
            },
            "settings": {
              "type": "object"
            }
          }
        }
      ]
    }
  }
}
