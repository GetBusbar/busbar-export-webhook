{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "request-log-webhook settings",
  "type": "object",
  "additionalProperties": false,
  "required": ["url"],
  "properties": {
    "url": {
      "type": "string",
      "description": "The webhook target URL: https:// only, refused by the host's policy when it targets an internal host."
    },
    "auth_header": {
      "type": "object",
      "description": "An optional auth header applied to every delivery from this instance.",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": {
          "type": "string",
          "description": "The header's name, e.g. Authorization."
        },
        "value": {
          "type": "string",
          "description": "The header's value (the credential), as written: a ${VAR} in it is filled from the environment when the config loads, so the secret is never stored literally."
        }
      }
    },
    "max_inflight_deliveries": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2305843009213693951,
      "default": 64,
      "description": "Max concurrent deliveries."
    },
    "delivery_timeout_secs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 946080000,
      "default": 2,
      "description": "Per-delivery timeout, seconds."
    }
  }
}
